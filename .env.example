# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM credentials. Any OpenAI-compatible endpoint works.
# AI Pipe token from https://aipipe.org/login (or a native sk-* / sk-or-* key).
LLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://aipipe.org/openai/v1
LLM_MODEL=gpt-4.1-mini

# Where run logs are published: "github" (permanent raw URLs) or "gcs"
LOG_BACKEND=github

# LOG_BACKEND=github
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main
GITHUB_LOG_DIR=logs

# LOG_BACKEND=gcs
GCS_BUCKET_NAME=tds-t2-bot-logs-xxxxxx
GCP_SERVICE_ACCOUNT_JSON=

# Reply shape: "envelope" -> {"answer": ..., "log_url": ...} (project spec)
#              "bare"     -> the answer object alone (strict exact-match graders)
REPLY_FORMAT=envelope

# Port for the Flask app (Render sets this automatically)
PORT=10000
